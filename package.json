{
  "name": "vite-plugin-vitepress-bar",
  "type": "module",
  "version": "0.0.1",
  "description": "为 vitepress 自动生成 nav 和 sidebar",
  "author": "onlymisaky <onlymisaky@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/onlymisaky/vite-plugin-vitepress-bar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlymisaky/vite-plugin-vitepress-bar.git"
  },
  "bugs": "https://github.com/onlymisaky/vite-plugin-vitepress-bar/issues",
  "keywords": [
    "vite-plugin",
    "vitepress",
    "vitepress-bar",
    "vitepress-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "release": "bumpp",
    "start": "esno src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "vite": "latest",
    "vitepress": "latest"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.0",
    "@types/node": "^22.10.2",
    "bumpp": "^9.9.1",
    "eslint": "^9.17.0",
    "esno": "^4.8.0",
    "lint-staged": "^15.2.11",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "unbuild": "^3.0.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
